# =============================================================================
# Lidera Final — Supabase (production project)
# ВАЖНО: старый проект "lidera" не используется.
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Секретный ключ. Только сервер, никогда не попадает в браузер.
# Взять: Supabase Dashboard → Lidera Final → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# Telegram-бот — рабочее место сотрудника.
# Токен выдаёт @BotFather. Секретный: только сервер.
# =============================================================================
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Любая длинная случайная строка: приходит в X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# Секрет планировщика авто-раздачи (openssl rand -hex 32)
CRON_SECRET=
